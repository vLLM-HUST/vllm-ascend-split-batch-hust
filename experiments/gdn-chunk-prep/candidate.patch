+        and has_state.dtype == torch.bool
+        and indices.ndim == has_state.ndim == 1
+        and indices.shape == has_state.shape
+        and (tokens, indices.numel()) in ((10, 1), (156, 15))
+        and has_state.is_contiguous()
+        and all(torch_npu.get_npu_format(x) in (0, 2) for x in (pool, indices, has_state))
+    ):
+        from vllm_ascend.ops.gdn_chunk_prep import prepare_chunk_initial_state
+
+        # Native indexing validates the IDs (including negative IDs) before any raw pool read.
+        rows = torch.arange(pool.shape[0], device=pool.device, dtype=torch.int32)[indices]
+        return prepare_chunk_initial_state(pool, rows, has_state)
+    initial_state = pool[indices]
+    clear_ssm_states(initial_state, has_state)
+    return initial_state
