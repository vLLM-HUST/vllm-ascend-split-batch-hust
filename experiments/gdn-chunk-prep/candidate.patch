+"""Gather checked state rows into the BF16 initial state consumed by fused Chunk."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit(do_not_specialize=["inner_size", "pool_stride"])
+def _gdn_chunk_prep_kernel(
+    pool_ptr,
+    idx_ptr,
+    has_ptr,
+    out_ptr,
+    inner_size,
+    pool_stride,
+    BLOCK: tl.constexpr,
+):
+    slot = tl.program_id(0)
+    cols = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = cols < inner_size
+    src_slot = tl.load(idx_ptr + slot).to(tl.int64)
+    has_state = tl.load(has_ptr + slot).to(tl.int1)
+    val = tl.load(pool_ptr + src_slot * pool_stride + cols, mask=mask, other=0.0)
+    val = tl.where(has_state, val, 0.0)
+    tl.store(out_ptr + slot * inner_size + cols, val.to(tl.bfloat16), mask=mask)
+
+
+def prepare_chunk_initial_state(ssm_state, checked_rows, has_state):
+    rows = checked_rows.numel()
+    inner_size = 16 * 128 * 128
+    out = torch.empty((rows, 16, 128, 128), dtype=torch.bfloat16, device=ssm_state.device)
+    block = 4096
+    _gdn_chunk_prep_kernel[(rows, triton.cdiv(inner_size, block))](
+        ssm_state, checked_rows, has_state, out, inner_size, ssm_state.stride(0), BLOCK=block
+    )
+    return out
