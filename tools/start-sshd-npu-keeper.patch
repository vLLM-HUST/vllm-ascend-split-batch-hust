--- a/start-sshd.sh
+++ b/start-sshd.sh
@@ -145,0 +146,18 @@
+echo "== NPU 空闲保活 =="
+KEEPER="$HUSK/tools/npu_idle_keeper.py"
+KEEPER_PY="${NPU_IDLE_KEEPALIVE_PY:-$PY}"
+if [ ! -f "$KEEPER" ]; then
+    echo "  保活脚本不存在，跳过: $KEEPER"
+elif [ "${NPU_IDLE_KEEPALIVE:-1}" = "0" ]; then
+    "$KEEPER_PY" "$KEEPER" stop
+elif ! command -v npu-smi >/dev/null 2>&1; then
+    echo "  未检测到 npu-smi，跳过保活"
+elif "$KEEPER_PY" "$KEEPER" status >/dev/null 2>&1; then
+    echo "  保活守护已在运行"
+else
+    setsid nohup "$KEEPER_PY" -u "$KEEPER" run \
+        </dev/null >>"$LOG_DIR/npu-idle-keeper.log" 2>&1 &
+    echo "  已发起保活守护；无 NPU 自动退出，有实际任务自动让路"
+    echo "  日志: $LOG_DIR/npu-idle-keeper.log"
+fi
+
