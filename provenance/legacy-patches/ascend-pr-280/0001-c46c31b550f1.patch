+def create_ascend_forward_context(
+    cur_forward_context: Any,
+    attn_metadata: Any,
+    vllm_config: VllmConfig,
+    virtual_engine: int = 0,
+    dp_metadata: Any = None,
+    cudagraph_runtime_mode: CUDAGraphMode = CUDAGraphMode.NONE,
+    batch_descriptor: BatchDescriptor | None = None,
+    ubatch_slices: Any = None,
+    ubatch_num: int = 0,
+    positions: Any = None,
+    in_parallel_streams: bool = False,
+    cos_sin_slot_id: int = 0,
+    reuse_existing_cos_sin: bool = False,
+    clone_cos_sin: bool = True,
+) -> Any:
+    from vllm.forward_context import ForwardContext
+
+    new_forward_context = ForwardContext(
+        no_compile_layers=vllm_config.compilation_config.static_forward_context,
+        attn_metadata=attn_metadata,
+        slot_mapping={},
+        dp_metadata=dp_metadata,
+        cudagraph_runtime_mode=cudagraph_runtime_mode,
+        batch_descriptor=batch_descriptor,
+        ubatch_slices=ubatch_slices,
+        in_parallel_streams=in_parallel_streams,
+    )
+
+    if attn_metadata is not None:
+        if isinstance(attn_metadata, dict):
+            attn_meta_i = next(iter(attn_metadata.values()))
+        else:
+            attn_meta_i = attn_metadata
+        new_forward_context.num_tokens = getattr(attn_meta_i, "num_actual_tokens", 0)
+
+    tp_world_size = get_tensor_model_parallel_world_size()
+    dp_world_size = get_dp_group().world_size
+
+    new_forward_context.moe_comm_type = getattr(cur_forward_context, "moe_comm_type", None)
+    from vllm_ascend.ops.fused_moe.moe_comm_method import get_moe_comm_method
+    try:
+        new_forward_context.moe_comm_method = get_moe_comm_method(
+            new_forward_context.moe_comm_type, ubatch_num)
+    except TypeError:
+        new_forward_context.moe_comm_method = get_moe_comm_method(
+            new_forward_context.moe_comm_type)
+    new_forward_context.sp_enabled = getattr(cur_forward_context, "sp_enabled", False)
+    new_forward_context.with_prefill = getattr(cur_forward_context, "with_prefill", True)
+    new_forward_context.in_profile_run = getattr(cur_forward_context, "in_profile_run", False)
+    new_forward_context.capturing = False
+    new_forward_context.mmrs_fusion = getattr(cur_forward_context, "mmrs_fusion", False)
+    new_forward_context.flash_comm_v1_enabled = getattr(cur_forward_context, "flash_comm_v1_enabled", False)
+    new_forward_context.flashcomm_v2_enabled = getattr(cur_forward_context, "flashcomm_v2_enabled", False)
+    new_forward_context.pad_size = 0
+    new_forward_context.is_first_layer = True
+    new_forward_context.layer_idx = getattr(cur_forward_context, "layer_idx", None)
+    new_forward_context.model_instance = getattr(cur_forward_context, "model_instance", None)
+    new_forward_context.is_draft_model = getattr(cur_forward_context, "is_draft_model", False)
+    new_forward_context.is_draft_model_prefill = False
+    new_forward_context.prefetch_mlp_enabled = getattr(cur_forward_context, "prefetch_mlp_enabled", False)
+    new_forward_context.weight_prefetch_method = getattr(cur_forward_context, "weight_prefetch_method", None)
